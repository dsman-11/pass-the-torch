# Copy this to .env on your computer. Never commit .env.
PASS_THE_TORCH_DB=data/pass-the-torch.sqlite3
PASS_THE_TORCH_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternative: set PASS_THE_TORCH_AI_PROVIDER=openai and fill these.
OPENAI_API_KEY=
OPENAI_MODEL=
# Set true ONLY when serving over HTTPS; localhost development uses false.
PASS_THE_TORCH_SECURE_COOKIE=false

# A separate fictional feedback database can be selected in the UI.
# Your profile, account and actual contributions always stay in PASS_THE_TORCH_DB.
PASS_THE_TORCH_DEMO_ENABLED=true
# Optional: otherwise placed next to PASS_THE_TORCH_DB, never in the same file.
PASS_THE_TORCH_DEMO_DB=
